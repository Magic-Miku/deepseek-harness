# 绘梦工坊/蓝色大肥鱼 的打包配置（占位值）
# 说明：这些是自动更新服务器地址。原值为 DeepSeek 内部基础设施，
# 我们没有访问权限，因此填占位值让构建通过。
# 影响：应用内的"自动更新"功能将无法工作（用户通过 Store 更新，不受影响）

DSH_DESKTOP_APP_ID=com.deepseek.harness

# 更新环境标识（官方允许 test/prod）
DSH_DESKTOP_AUTO_UPDATE_ENV=test

# 占位：更新下载服务器
DOWNLOAD_TEST_ORIGIN=https://example.invalid/dsh-downloads

# 占位：32 位十六进制发布 ID（格式校验用）
DOWNLOAD_TEST_RELEASE_ID=00000000000000000000000000000000

# 占位：强制更新检查地址（两行都是 required）
DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=https://example.invalid/dsh-update-test
DSH_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=https://example.invalid/dsh-update-prod

# 占位：登录来源白名单
DSH_DESKTOP_MANDATORY_UPDATE_CONFIG={"allowedAuthOrigins":["https://example.invalid"]}

# 签名相关留空（Store 会替我们重签，不需要自签）
DSH_DESKTOP_WINDOWS_CER_FILE=
DSH_DESKTOP_WINDOWS_SIGNTOOL=
DSH_DESKTOP_WINDOWS_KEY_CONTAINER=
DSH_DESKTOP_WINDOWS_TOKEN_PIN=
DSH_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4
